# Spotify Developer App Credentials
# Create at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Dual User Refresh Tokens (captured by running python scripts/auth_spotify.py)
ELLIOTT_SPOTIFY_REFRESH_TOKEN=
CHLOE_SPOTIFY_REFRESH_TOKEN=

# Optional: Specific Playlist IDs (if not auto-discovered)
ELLIOTT_DISCOVER_WEEKLY_ID=
CHLOE_DISCOVER_WEEKLY_ID=

# The Guardian Open Platform API Key (Free registration at https://open-platform.theguardian.com/access/)
GUARDIAN_API_KEY=

# Delivery: Gmail SMTP with Google App Password (recommended for simple local delivery)
# Generate App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
DIGEST_RECIPIENTS=elliott@example.com,chloe@example.com

# Delivery: Alternative SendGrid API
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=digest@livecurator.local
